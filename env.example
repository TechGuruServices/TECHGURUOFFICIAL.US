# TechGuru Cloudflare Workers Environment Variables
# For local testing with Wrangler, rename this to .dev.vars
# For production, utilize Cloudflare Dashboard > Settings > Variables

# Web3Forms API Key for Email Submissions
# Get from: https://web3forms.com
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Anthropic API Key for Claude AI Chat
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Admin Email Address
# Fallback email for notifications (usually configured in Web3Forms directly though)
ADMIN_EMAIL=info@techguruofficial.us

# Systeme.io Public API Key — syncs lead-magnet and contact-form
# submissions into Systeme.io so its automations can auto-deliver
# the checklist and run your nurture/follow-up sequences.
# Get from: systeme.io > profile icon (top right) > Settings >
#           MCP & API keys > Public API keys > Create
# Leave blank to disable the Systeme.io sync (everything else still works).
SYSTEME_API_KEY=your_systeme_io_public_api_key_here
